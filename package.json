{
  "name": "siigo-pyme-mcp",
  "version": "0.3.0",
  "description": "Servidor MCP para SIIGO Pyme: expone las 47 funciones de EXCELSIIGO.exe como herramientas (movimiento contable, terceros, inventarios, activos, nomina e informes).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "siigo",
    "siigo-pyme",
    "excelsiigo",
    "contabilidad",
    "colombia",
    "stdio",
    "npx"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "bin": {
    "siigo-pyme-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:tools": "node scripts/test-all-tools.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.6.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javalenciacai/siigo-pyme-mcp"
  },
  "bugs": {
    "url": "https://github.com/javalenciacai/siigo-pyme-mcp/issues"
  },
  "homepage": "https://github.com/javalenciacai/siigo-pyme-mcp#readme",
  "mcpName": "io.github.javalenciacai/siigo-pyme-mcp"
}
